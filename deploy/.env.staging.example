# Local staging (docker-compose.staging.yml). "deploy/staging.ps1 init" copies this file to .env.staging
# (git-ignored) and replaces every CHANGE_ME with a random value. Never commit .env.staging.

# staging,devseed = with the development accounts (password in dev/README.md); staging = empty database
SPRING_PROFILES_ACTIVE=staging,devseed

# Published ports, all bound to 127.0.0.1 (this PC only)
STAGING_HTTP_PORT=8088
# 0.0.0.0 opens the application to the local network. With the dev seed on (devseed), anyone on that network can
# log in with the test accounts (known password). Keep 127.0.0.1 unless you need another device.
WEB_BIND=127.0.0.1
STAGING_MAILPIT_PORT=8026
STAGING_POSTGRES_PORT=5433
STAGING_MINIO_CONSOLE_PORT=9011

POSTGRES_DB=recrutamento
POSTGRES_USER=recrutamento
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=recrutamento
MINIO_ROOT_PASSWORD=CHANGE_ME
# "<key-name>:<32 random bytes in base64>"; losing it makes the stored files unreadable
MINIO_KMS_SECRET_KEY=CHANGE_ME

APP_JWT_SECRET=CHANGE_ME
APP_AUTH_TOKEN_PEPPER=CHANGE_ME
# 32 random bytes in base64 (SMTP passwords of the settings)
APP_SECRETS_KEY=CHANGE_ME
