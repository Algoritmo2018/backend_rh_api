# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Local infrastructure (docker compose, dev profile) ---
POSTGRES_DB=recrutamento
POSTGRES_USER=recrutamento
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# MinIO (file storage). The application uses the same credentials in the dev profile.
MINIO_ROOT_USER=recrutamento
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_PORT=9000
# Server-side encryption key of MinIO: "<key-name>:<32 random bytes in base64>", e.g.
#   echo "recrutamento-key:$(openssl rand -base64 32)"
# Required by docker compose. Generate your own; never commit it. Losing it makes the stored files unreadable.
MINIO_KMS_SECRET_KEY=recrutamento-key:REPLACE_WITH_OPENSSL_RAND_BASE64_32

# --- Production (prod profile) ---
DB_URL=jdbc:postgresql://db-host:5432/recrutamento
DB_USERNAME=recrutamento
DB_PASSWORD=change-me
# HS256 key: at least 32 random characters (e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=change-me-to-a-long-random-secret
# Key used to hash SMS codes (at least 32 random characters, different from the JWT secret)
APP_AUTH_TOKEN_PEPPER=change-me-to-another-long-random-secret
# AES-256-GCM key of the secrets stored in the database (SMTP passwords of the settings): `openssl rand -base64 32`.
# Needed in every environment where SMTP accounts are configured (also dev). Losing it makes the stored passwords
# unreadable (re-enter them). Rotation: move the old value to APP_SECRETS_KEY_PREVIOUS and set a new one.
APP_SECRETS_KEY=
APP_SECRETS_KEY_PREVIOUS=
# Phone + SMS code login (needs a real SMS provider)
APP_AUTH_OTP_LOGIN_ENABLED=false
APP_FRONTEND_URL=https://example.ao/software_rh
APP_CANDIDATE_PORTAL_URL=https://example.ao/software_rh/candidato
# Comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=https://example.ao
# "framework" only behind a trusted reverse proxy that overwrites X-Forwarded-For
SERVER_FORWARD_HEADERS_STRATEGY=none

# File storage: private S3 bucket (or MinIO). Endpoint empty for AWS S3; keys empty → AWS default credentials chain
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_REGION=af-south-1
APP_STORAGE_S3_BUCKET=recrutamento-files
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=
# false for AWS S3 (virtual-hosted style), true for MinIO
APP_STORAGE_S3_PATH_STYLE=false

# SMTP
MAIL_HOST=smtp.example.ao
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=FEH OIRAM <nao-responder@example.ao>

# First administrator (created on startup if there is no admin; receives an invitation email)
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_PHONE=
