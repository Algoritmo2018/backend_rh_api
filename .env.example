# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Local infrastructure (docker compose, dev profile) ---
POSTGRES_DB=recrutamento
POSTGRES_USER=recrutamento
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Production (prod profile) ---
DB_URL=jdbc:postgresql://db-host:5432/recrutamento
DB_USERNAME=recrutamento
DB_PASSWORD=change-me
# HS256 key: at least 32 random characters (e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=change-me-to-a-long-random-secret
# Key used to hash SMS codes (at least 32 random characters, different from the JWT secret)
APP_AUTH_TOKEN_PEPPER=change-me-to-another-long-random-secret
# Phone + SMS code login (needs a real SMS provider)
APP_AUTH_OTP_LOGIN_ENABLED=false
APP_FRONTEND_URL=https://example.ao/software_rh
APP_CANDIDATE_PORTAL_URL=https://example.ao/software_rh/candidato
# Comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=https://example.ao
# "framework" only behind a trusted reverse proxy that overwrites X-Forwarded-For
SERVER_FORWARD_HEADERS_STRATEGY=none

# SMTP
MAIL_HOST=smtp.example.ao
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=FEH OIRAM <nao-responder@example.ao>

# First administrator (created on startup if there is no admin; receives an invitation email)
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_PHONE=
